<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Recept Bolaget</title>
  <link rel="stylesheet" type="text/css" href="/style.css?<%= Time.now.to_i %>">
</head>

<body>
  <header class="topbar">
    <div class="container topbar__inner">
      <a class="brand" href="/">Recept Bolaget</a>

      <nav class="actions">
        <a class="btn btn--ghost" href="/groups">Groups</a>
        
        <% if session[:user_id]%>
          <form action="/logout" method="post" style="display:inline;">
            <button type="submit" class="btn btn--ghost link-button">Log out</button>
          </form>

          <form action="/users/:id/delete" method="post" style="display:inline;">
            <button type="submit" class="btn btn--ghost link-button">Delete user</button>
          </form>

          <a class="btn btn--primary" href="/users/<%=session[:user_id]%>/edit">Change password</a>

          <a class="btn btn--primary" href="/recipes/new">Create new</a>
        
        <%else%>
        <a class="btn btn--ghost" href="/login">Log in</a>
        <a class="btn btn--ghost" href="/users/new">Sign up</a>
        <%end%>
        
      </nav>
    </div>
  </header>

  <main class="container">
    <%= yield %>
  </main>

  <footer class="footer">
    <div class="container footer__inner">
      <span class="muted">© <%= Time.now.year %> Recept Bolaget</span>
    </div>
  </footer>
</body>
</html>